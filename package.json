{
  "name": "tiki-golf",
  "private": true,
  "version": "1.0.0",
  "description": "Tiki Golf: Island Adventures, a tropical 3D mini golf game.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:artifact": "vite build --mode single && node tools/make-artifact.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
